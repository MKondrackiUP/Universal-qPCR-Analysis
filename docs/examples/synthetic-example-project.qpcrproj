      "specification_version": "1.0.0",
      "profile_id": "synthetic-example-evidence-profile-v1",
      "formula": "qpcr_signal + defined_compound + context_specific_evidence + mechanistic_fit + transcriptomic_readiness - safety_risk",
      "weights": {
        "qpcr_signal": 1,
        "defined_compound": 1,
        "context_specific_evidence": 1,
        "mechanistic_fit": 1,
        "transcriptomic_readiness": 1,
        "safety_risk": 1
      },
      "rules": {
        "tier1_min_score": 4,
        "tier2_min_score": 2.5,
        "tier3_min_score": 2.5,
        "tier1_requires_goal_aligned_qpcr": true,
        "tier1_min_defined_compound_score": 2,
        "tier1_min_mechanistic_fit_score": 1,
        "goal_opposed_qpcr_forces_tier5": true,
        "undefined_or_not_transcriptomic_ready_forces_tier4": true,
        "negative_mechanistic_fit_forces_exploratory_tier3": true,
        "zero_mechanistic_and_context_support_forces_tier3": true,
        "missing_evidence_profile_forces_tier4": true
      },
      "interpretation": "Tier is a versioned prioritization category produced by the complete integrated evidence profile. It is not a clinical or efficacy classification. The statistical qPCR assessment remains a separate result.",
